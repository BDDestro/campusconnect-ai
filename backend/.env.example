# ---------------------------------------------------------------------------
# CampusConnect AI - backend settings
# Copy this file to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# SQLite works out of the box. For Supabase/Postgres use:
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-4f8a2c9e7b1d6a3f5c0e8b2d7a9f4c1e

# Login token lifetime in minutes.
TOKEN_MINUTES=720

# Bootstrap administrator (created on first start; never available via sign-up).
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin123!

# Populate the database with demo students, reports and complaints on first run.
AUTO_SEED=true

# Upload limits.
MAX_UPLOAD_MB=5

# Optional: Gemini complaint classification. Leave empty to use the built-in
# keyword classifier (works offline, no key needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated origins for a separate Flutter web client. Same-origin web
# app needs nothing here. Use * for local development.
CORS_ORIGINS=*
