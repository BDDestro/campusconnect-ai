# ---------------------------------------------------------------------------
# CampusConnect AI - Docker Compose settings
#
# Copy this file to `.env` in the project root, then edit the values.
# Compose reads `.env` automatically; never commit it.
#
# Generate a production secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------

# Host port. The app always listens on 8080 inside the container.
# 8081 avoids Docker Desktop's own use of host port 8080 on Windows.
PORT=8081

# JWT signing key. Replace this before exposing the app to anyone else.
SECRET_KEY=dev-only-change-me-docker-4f8a2c9e7b1d6a3f5c0e8b2d7a9f4c1e

# Login token lifetime in minutes.
TOKEN_MINUTES=720

# Bootstrap administrator, created only on the first start.
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin123!

# Seed demo students, reports, complaints and matches when the volume is empty.
AUTO_SEED=true

# Upload limit in megabytes.
MAX_UPLOAD_MB=5

# Optional Gemini complaint triage. Leave empty to use local keyword rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated allowed origins. Same-origin web app needs no change.
CORS_ORIGINS=*
